# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/gyansync

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Email Configuration (for password reset emails)
# Using Gmail: https://support.google.com/accounts/answer/185833
# You need to generate an App Password for your Gmail account
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Alternative: Use other email services by updating the emailService.js configuration
# Examples: SendGrid, Mailgun, Amazon SES, etc.

# Server Port
PORT=5000
